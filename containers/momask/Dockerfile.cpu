FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl unzip \
    && rm -rf /var/lib/apt/lists/*

# ── Clone MoMask repo ─────────────────────────────────────────────────────
RUN git clone --depth=1 https://github.com/EricGuo5513/momask-codes.git /app/momask

# ── numpy 2.x compat patches (np.float, np.int, np.bool removed in 2.x) ─
RUN find /app/momask -name "*.py" -exec sed -i \
        -e 's/np\.float\b/float/g' \
        -e 's/np\.int\b/int/g' \
        -e 's/np\.bool\b/bool/g' \
        -e 's/np\.complex\b/complex/g' \
        -e 's/np\.object\b/object/g' {} + 2>/dev/null || true

# ── CPU-only PyTorch ──────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
    torch==2.2.2 --index-url https://download.pytorch.org/whl/cpu

# ── Shared + model-specific dependencies ──────────────────────────────────
RUN pip install --no-cache-dir \
    fastapi==0.111.0 \
    "uvicorn[standard]==0.29.0" \
    numpy==1.26.4 \
    scipy==1.13.0 \
    einops==0.7.0 \
    gdown==5.2.0 \
    pyyaml==6.0.2 \
    "git+https://github.com/openai/CLIP.git" \
    vector-quantize-pytorch==1.6.30

WORKDIR /app

# ── Download MoMask checkpoints (HumanML3D) ───────────────────────────────
RUN python -m gdown --fuzzy \
    "https://drive.google.com/file/d/1vXS7SHJBgWPt59wupQ5UUzhFObrnGkQ0/view?usp=sharing" \
    -O /tmp/hml_momask.zip && \
    mkdir -p /app/checkpoints/t2m && \
    unzip -q /tmp/hml_momask.zip -d /app/checkpoints/t2m/ && \
    rm /tmp/hml_momask.zip

COPY app.py inference.py inference_momask.py ./

ENV MOMASK_PATH=/app/momask
ENV CHECKPOINTS_DIR=/app/checkpoints

EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
