# AnimoFlow stack configuration — single source of truth.
# docker-compose.yml, install.sh, nodes/, and start.sh all read from here.
# install.sh copies this to .env on first run; edit .env, not this file.

# ── Service ports (change only on conflict; install.sh doctor checks them) ──
MDM_PORT=8001
PRIORMDM_PORT=8002
MOMASK_PORT=8003
KIMODO_PORT=8005
RETARGETER_PORT=8006

# ── Endpoint URLs the ComfyUI nodes call (localhost for a local stack) ──────
MDM_ENDPOINT=http://localhost:${MDM_PORT}
PRIORMDM_ENDPOINT=http://localhost:${PRIORMDM_PORT}
MOMASK_ENDPOINT=http://localhost:${MOMASK_PORT}
KIMODO_ENDPOINT=http://localhost:${KIMODO_PORT}
RETARGETER_URL=http://localhost:${RETARGETER_PORT}

# ── MDM weights (host path, bind-mounted into the mdm container) ────────────
# Populated by `./install.sh weights`. Must contain model000750000.pt.
# Uncomment to override the default (~/animoflow/models/mdm/humanml_enc_512_50steps):
# MDM_WEIGHTS_DIR=

# ── Blender (needed by AnimoFlow_Rig FBX export + AnimoFlow_GLBExport) ──────
# install.sh doctor auto-detects common locations; set explicitly if yours
# lives elsewhere. Examples:
#   macOS:  BLENDER_BIN="/Applications/Blender.app/Contents/MacOS/Blender"
#   Linux:  BLENDER_BIN=/usr/bin/blender
# BLENDER_BIN=

# ── Kimodo (GPU-only, started with `./install.sh up --gpu`) ─────────────────
# KIMODO_MODEL=Kimodo-SOMA-RP-v1
# HF_TOKEN=            # Hugging Face token for the weight download
